{
  "schemaVersion":"FLR_V41_BROWSER_CAPTURE_CONTRACT_1.0",
  "targets":["LOCAL","HOSTED"],
  "requiredFields":["candidateSourceSHA","runtimeSourceSHA","validatorHead","deployedBuildSHA","captureManifest","scenarioId","seed","startState","firstVisibleReaction","visiblePoseOrOwnership","terminalEvent","timestamps","frameIndices","screenshotsOrSerializedVisualEvidence","resultStatus","familyEvidence"],
