  "policy":{"hostedCaptureCannotBeInferred":true,"rendererVisibleClaimsRequireScreenshots":true,"gkRequiresFirstReactionTravelTerminalPose":true,"familyEvidenceRequired":["PROTAGONIST_AUTHORITY","CONTINUITY_REPLAY","SET_PIECE_CAUSALITY","GK_ENGINE_TO_RENDER"],"defensiveResponsibilityMayUseTelemetry":true,"noGameplayMutation":true}
